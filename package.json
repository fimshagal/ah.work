{
  "name": "ahwork",
  "version": "0.0.0",
  "description": "AhWork — a lightweight task-oriented runtime that orchestrates a pool of Web Workers.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/ahwork.js",
  "module": "./dist/ahwork.js",
  "types": "./dist/ahwork.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/ahwork.node.d.ts",
        "import": "./dist/ahwork.node.js"
      },
      "browser": {
        "types": "./dist/ahwork.d.ts",
        "import": "./dist/ahwork.js"
      },
      "default": {
        "types": "./dist/ahwork.d.ts",
        "import": "./dist/ahwork.js"
      }
    },
    "./browser": {
      "types": "./dist/ahwork.d.ts",
      "import": "./dist/ahwork.js"
    },
    "./node": {
      "types": "./dist/ahwork.node.d.ts",
      "import": "./dist/ahwork.node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:browser": "playwright install chromium && vitest run --config vitest.browser.config.ts",
    "test:all": "npm test && npm run test:node && npm run test:browser",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "examples": "vite --config examples/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts"
  },
  "keywords": [
    "web-worker",
    "worker-pool",
    "runtime",
    "parallel",
    "scheduler",
    "ahwork"
  ],
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^2.1.9",
    "eslint": "^9.13.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  }
}
